# Copy to .env (repository root) and adjust. Never commit .env.
# All values are server-side only; none are exposed to the frontend.
# Local DB: docker compose -f infrastructure/local/compose.yaml up -d

# --- API (backend/apps/api) ----------------------------------------------
# DATABASE_URL is the *runtime* role used by `api` (serve). In production it is
# a LOGIN role that is a member of `a2a_app` (SELECT/INSERT/UPDATE only, no DDL,
# no DELETE). Locally the owner is fine. See docs/PHASE3.md "Database roles".
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/a2a
# Schema owner, used only by `api migrate` (falls back to DATABASE_URL).
# DATABASE_MIGRATION_URL=
#
# Supabase: use the *direct* connection or the *session* pooler (port 5432).
# The transaction pooler (port 6543) does not support SQLx prepared statements
# or the session-level instance lock. Any non-loopback host MUST use
# sslmode=verify-full (startup refuses `require`, which does not verify the
# certificate); download the project's CA certificate from the Supabase
# dashboard (Database settings > SSL) and point sslrootcert at it.
# DATABASE_URL=postgresql://a2a_api.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/path/to/supabase-ca.crt
# DATABASE_MIGRATION_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/path/to/supabase-ca.crt
ORCHESTRATOR_BIND=127.0.0.1:8080
WORKER_URL=http://127.0.0.1:9101
REVIEWER_URL=http://127.0.0.1:9102
AGENT_TIMEOUT_SECS=240
AGENT_POLL_INTERVAL_MS=500
DB_MAX_CONNECTIONS=5
# Phase 4: the portal is server-rendered by Astro (frontend/), so the API no
# longer serves a static build. Leave FRONTEND_DIR unset.
# FRONTEND_DIR=

# --- Portal (frontend/, Astro SSR) --------------------------------------------
# Server-side only; the browser talks to the portal, never to the API.
# API_ORIGIN=http://127.0.0.1:8080   # where the portal reaches the Rust API
# API_TIMEOUT_MS=10000
# PORTAL_HOST=127.0.0.1
# PORTAL_PORT=4321
# LOG_FORMAT=json
# RUST_LOG=info

# --- Agents (backend/apps/worker-agent, backend/apps/reviewer-agent) ---------
WORKER_BIND=127.0.0.1:9101
WORKER_PUBLIC_URL=http://127.0.0.1:9101
REVIEWER_BIND=127.0.0.1:9102
REVIEWER_PUBLIC_URL=http://127.0.0.1:9102

# mock (deterministic, default; no key needed) or anthropic. Chosen explicitly:
# a provider failure is reported as a failed task, never answered by the mock.
INFERENCE_MODE=mock
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# LLM_EFFORT=medium             # low | medium | high | xhigh | max
# LLM_MAX_TOKENS=16000
# LLM_TIMEOUT_SECS=120   # per HTTP attempt
# LLM_DEADLINE_SECS=200  # all attempts + backoff; keep below the API's AGENT_TIMEOUT_SECS
# ANTHROPIC_REFUSAL_FALLBACK=default   # set to `off` to disable server-side refusal fallback
