# All values are server-side only; none are exposed to the frontend.
# Local DB: docker compose -f infrastructure/local/compose.yaml up -d

# `json` for one JSON log object per line (api, worker, reviewer, role agents;
# the container images set it). RUST_LOG sets the filter (default `info`).
# LOG_FORMAT=json

# --- API (backend/apps/api) ----------------------------------------------
DATABASE_URL=
ORCHESTRATOR_BIND=
WORKER_URL=
REVIEWER_URL=
AGENT_TIMEOUT_SECS=
AGENT_POLL_INTERVAL_MS=
DB_MAX_CONNECTIONS=

# --- Agents (backend/apps/worker-agent, backend/apps/reviewer-agent) ---------
WORKER_BIND=
WORKER_PUBLIC_URL=
REVIEWER_BIND=
REVIEWER_PUBLIC_URL=

# --- LLM (worker, reviewer, and ENG_PROVIDER=anthropic) -----------------------
# `mock` (default) or `anthropic`; `anthropic` needs ANTHROPIC_API_KEY.
INFERENCE_MODE=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# ANTHROPIC_BASE_URL=
# LLM_TIMEOUT_SECS=120
# LLM_DEADLINE_SECS=200
# LLM_MAX_TOKENS=16000
# LLM_EFFORT=medium
# ANTHROPIC_REFUSAL_FALLBACK=on

# --- Phase 6 engineering workflows (api) --------------------------------------
# `none` (default), `anthropic` (non-executing roles only) or `a2a`
# (all six roles via role-agents + mcp-server; needs the three vars below).
ENG_PROVIDER=
# Full 40-hex base commit for work assignments.
ENG_BASE_COMMIT_SHA=
# ROLE_AGENTS_URL=http://127.0.0.1:9111
# MCP_CONTROL_URL=http://127.0.0.1:8090
# Hex HMAC key, >= 32 bytes, shared with mcp-server. Generate: openssl rand -hex 32
# MCP_TOKEN_KEY=
# ENG_A2A_PROVIDER_LABEL=deterministic
# ENG_STAGE_TIMEOUT_SECS=600

# --- MCP server (backend/apps/mcp-server) -------------------------------------
# Unset lines use the default shown. MCP_BIND must be a loopback address.
# MCP_BIND=127.0.0.1:8090
# MCP_TOKEN_KEY=            (same value as above)
# MCP_WORKSPACES_ROOT=
# Login role in `a2a_mcp` (INSERT on eng_tool_calls only).
# MCP_DATABASE_URL=
# MCP_SOURCE_REPO=
# Digest-pinned image for testing.run; unset = testing.run answers sandbox_unavailable.
# A2A_SANDBOX_IMAGE=
# A2A_SANDBOX_TIMEOUT_SECS=600
# A2A_SANDBOX_MEMORY=2g
# A2A_SANDBOX_CPUS=2
# A2A_SANDBOX_PIDS=256

# --- Role agents (backend/apps/role-agents) -----------------------------------
# ROLE_AGENTS_BIND=127.0.0.1:9111
# ROLE_AGENTS_PUBLIC_URL=http://127.0.0.1:9111
# ROLE_AGENT_MCP_URL=http://127.0.0.1:8090/mcp
# DEVELOPER_PATCH_FILE=
# PM_SCOPE=src
