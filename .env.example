# Copy to .env (repository root) and adjust. Never commit .env.
# All values are server-side only; none are exposed to the frontend.
# Local DB: docker compose -f infrastructure/local/compose.yaml up -d

# --- API (backend/apps/api) ----------------------------------------------
# Supabase: use the *direct* connection or the *session* pooler (port 5432).
# The transaction pooler (port 6543) does not support the prepared statements SQLx uses.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/a2a
ORCHESTRATOR_BIND=127.0.0.1:8080
WORKER_URL=http://127.0.0.1:9101
REVIEWER_URL=http://127.0.0.1:9102
AGENT_TIMEOUT_SECS=240
AGENT_POLL_INTERVAL_MS=500
DB_MAX_CONNECTIONS=5
FRONTEND_DIR=frontend/dist
# LOG_FORMAT=json
# RUST_LOG=info

# --- Agents (backend/apps/worker-agent, backend/apps/reviewer-agent) ---------
WORKER_BIND=127.0.0.1:9101
WORKER_PUBLIC_URL=http://127.0.0.1:9101
REVIEWER_BIND=127.0.0.1:9102
REVIEWER_PUBLIC_URL=http://127.0.0.1:9102

# mock (deterministic, default) or anthropic
INFERENCE_MODE=mock
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# LLM_EFFORT=medium
# LLM_TIMEOUT_SECS=120   # per HTTP attempt
# LLM_DEADLINE_SECS=200  # all attempts + backoff; keep below the API's AGENT_TIMEOUT_SECS
# ANTHROPIC_REFUSAL_FALLBACK=default   # set to `off` to disable server-side refusal fallback
