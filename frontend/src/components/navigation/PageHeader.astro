---
// Page title block. Optional breadcrumb (`crumbs`) and `actions` slot.
interface Props {
  title: string;
  description?: string;
  crumbs?: { href: string; label: string }[];
}
const { title, description, crumbs } = Astro.props;
---

<div class="page-header">
  {
    crumbs && crumbs.length > 0 && (
      <nav class="page-header__crumbs" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((c) => (
            <li>
              <a href={c.href}>{c.label}</a>
            </li>
          ))}
          <li aria-current="page" class="page-header__current">
            <slot name="crumb">{title}</slot>
          </li>
        </ol>
      </nav>
    )
  }
  <div class="page-header__row">
    <div class="page-header__text">
      <h1 class="page-header__title">
        <slot name="title">{title}</slot>
      </h1>
      {description && <p class="page-header__description">{description}</p>}
      <slot name="meta" />
    </div>
    {
      Astro.slots.has("actions") && (
        <div class="page-header__actions">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</div>

<style>
  .page-header {
    margin-bottom: var(--space-5);
  }
  .page-header__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
    padding: 0;
    margin: 0 0 var(--space-2);
    list-style: none;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
  .page-header__crumbs li + li::before {
    content: "/";
    margin-right: var(--space-1);
    color: var(--color-border-strong);
  }
  .page-header__crumbs a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }
  .page-header__crumbs a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }
  .page-header__current {
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .page-header__row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .page-header__text {
    min-width: 0;
    flex: 1 1 320px;
  }
  .page-header__title {
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
  }
  .page-header__description {
    margin-top: var(--space-2);
    max-width: 68ch;
    color: var(--color-text-secondary);
  }
  .page-header__actions {
    display: flex;
    gap: var(--space-2);
  }
</style>
