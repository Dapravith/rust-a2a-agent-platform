---
// Workflow rows: question, status, review verdict, submitted time.
// Desktop shows aligned columns with a header; narrow screens stack each row.
import Icon from "../../../components/ui/Icon.astro";
import { formatDuration, formatUtc, shortId, truncate } from "../../../lib/format.ts";
import type { Workflow } from "../schemas.ts";
import WorkflowBadge from "./WorkflowBadge.astro";

interface Props {
  items: Workflow[];
  compact?: boolean;
}
const { items, compact = false } = Astro.props;
---

<div class:list={["wf-list", compact && "wf-list--compact"]}>
  {
    !compact && (
      <div class="wf-list__head" aria-hidden="true">
        <span>Task</span>
        <span>Status</span>
        <span>Review</span>
        <span>Submitted</span>
      </div>
    )
  }
  <ol class="wf-list__items">
    {
      items.map((w) => {
        const took = formatDuration(w.started_at, w.finished_at);
        return (
          <li class="wf-row">
            <div class="wf-row__main">
              <a class="wf-row__link" href={`/workflows/${w.id}`}>
                {truncate(w.question, compact ? 110 : 180)}
              </a>
              <span class="wf-row__id mono">
                <span class="sr-only">Workflow </span>
                {shortId(w.id)}
                {took && <span class="wf-row__took"> · {took}</span>}
              </span>
            </div>
            <div class="wf-row__meta">
            <div class="wf-row__cell wf-row__status">
              <span class="sr-only">Status: </span>
              <WorkflowBadge status={w.status} />
            </div>
            <div class:list={["wf-row__cell", "wf-row__verdict", !w.verdict && w.status !== "failed" && "wf-row__verdict--empty"]}>
              <span class="sr-only">Review: </span>
              {w.verdict ? <WorkflowBadge verdict={w.verdict} /> : <span class="wf-row__none">{w.status === "failed" ? "Not reviewed" : "—"}</span>}
            </div>
            <div class="wf-row__cell wf-row__time">
              <span class="sr-only">Submitted </span>
              <time datetime={w.created_at} data-local>
                {formatUtc(w.created_at)}
              </time>
            </div>
            </div>
            <Icon name="chevron-right" size={16} class="wf-row__chevron" />
          </li>
        );
      })
    }
  </ol>
</div>

<style>
  .wf-list {
    --wf-columns: minmax(0, 1fr) 128px 160px 168px 16px;
  }
  .wf-list__head {
    display: grid;
    grid-template-columns: var(--wf-columns);
    gap: var(--space-4);
    padding: var(--space-2) var(--space-5);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-sunken);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }
  .wf-list__items {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .wf-row {
    position: relative;
    display: grid;
    grid-template-columns: var(--wf-columns);
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5);
    border-bottom: 1px solid var(--color-border);
    transition: background-color var(--duration-fast) var(--ease);
  }
  .wf-row:last-child {
    border-bottom: 0;
  }
  .wf-row:hover {
    background: var(--color-surface-hover);
  }
  .wf-row__main {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .wf-row__link {
    color: var(--color-text);
    font-weight: var(--weight-medium);
    text-decoration: none;
    overflow-wrap: anywhere;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* The whole row is the click target; the link stays the accessible name. */
  .wf-row__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .wf-row__link:focus-visible {
    outline: none;
  }
  .wf-row:has(.wf-row__link:focus-visible) {
    outline: 2px solid var(--focus-ring-color);
    outline-offset: -2px;
  }
  .wf-row__id {
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
  }
  .wf-row__took {
    font-family: var(--font-sans);
  }
  .wf-row__none {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }
  .wf-row__time {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }
  .wf-row :global(.wf-row__chevron) {
    color: var(--color-text-disabled);
  }

  /* Compact (dashboard): question + badges, no column header. */
  .wf-list--compact {
    --wf-columns: minmax(0, 1fr) auto 16px;
  }
  .wf-list--compact .wf-row {
    padding: var(--space-3) var(--space-5);
    gap: var(--space-3);
  }
  .wf-list--compact .wf-row__time,
  .wf-list--compact .wf-row__verdict {
    display: none;
  }

  .wf-row__meta {
    display: contents;
  }

  @media (max-width: 760px) {
    .wf-list__head {
      display: none;
    }
    .wf-row,
    .wf-list--compact .wf-row {
      grid-template-columns: minmax(0, 1fr) 16px;
      row-gap: var(--space-2);
      padding: var(--space-3) var(--space-4);
    }
    .wf-row__main {
      grid-column: 1;
    }
    .wf-row__meta {
      grid-column: 1;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2) var(--space-3);
    }
    .wf-row :global(.wf-row__chevron) {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .wf-list--compact .wf-row__time {
      display: inline;
    }
    .wf-row__verdict--empty {
      display: none;
    }
  }
</style>
