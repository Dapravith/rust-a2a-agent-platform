---
import Base from "../../layouts/Base.astro";
---

<Base title="History" active="history">
  <h1>Workflow history</h1>
  <p class="lead">Every submission is persisted, including failed runs.</p>

  <section class="card">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Question</th>
            <th scope="col">Status</th>
            <th scope="col">Verdict</th>
            <th scope="col">Submitted</th>
          </tr>
        </thead>
        <tbody id="rows"></tbody>
      </table>
    </div>
    <div id="list-status" aria-live="polite"><p class="msg msg-info"><span class="spinner"></span> Loading…</p></div>
    <div class="form-row"><span></span><button id="more" class="secondary" type="button" hidden>Load more</button></div>
  </section>
</Base>

<script>
  import { api, ApiError, type Workflow } from "../../scripts/api";
  import { badge, byId, formatTime, h, message } from "../../scripts/dom";

  const rows = byId<HTMLTableSectionElement>("rows");
  const statusBox = byId("list-status");
  const more = byId<HTMLButtonElement>("more");
  let cursor: string | null = null;

  function row(w: Workflow): HTMLTableRowElement {
    const text = w.question.length > 160 ? `${w.question.slice(0, 160)}…` : w.question;
    return h(
      "tr",
      {},
      h("td", { class: "question" }, h("a", { href: `/workflow/?id=${encodeURIComponent(w.id)}` }, text)),
      h("td", {}, badge(w.status)),
      h("td", {}, w.verdict ? badge(w.verdict) : "—"),
      h("td", {}, formatTime(w.created_at)),
    );
  }

  async function load() {
    more.disabled = true;
    try {
      const page = await api.list(cursor ?? undefined);
      rows.append(...page.items.map(row));
      cursor = page.next_before;
      statusBox.replaceChildren();
      if (rows.children.length === 0) {
        statusBox.append(message("empty", "No workflows yet. Submit one from the Submit page."));
      }
      more.hidden = cursor === null;
    } catch (e) {
      statusBox.replaceChildren(message("error", e instanceof ApiError ? e.message : "Could not load history."));
    } finally {
      more.disabled = false;
    }
  }

  more.addEventListener("click", () => void load());
  void load();
</script>
