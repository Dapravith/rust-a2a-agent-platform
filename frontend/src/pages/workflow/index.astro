---
import Base from "../../layouts/Base.astro";
// Static page; the workflow id comes from the `?id=` query parameter at runtime.
---

<Base title="Workflow">
  <div id="root" aria-live="polite">
    <p class="msg msg-info"><span class="spinner"></span> Loading workflow…</p>
  </div>
</Base>

<script>
  import { api, ApiError, type AgentRun, type WorkflowDetail } from "../../scripts/api";
  import { badge, byId, duration, formatTime, h, message } from "../../scripts/dom";

  const root = byId("root");
  const id = new URLSearchParams(window.location.search).get("id") ?? "";
  const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

  function runRow(r: AgentRun): HTMLTableRowElement {
    return h(
      "tr",
      {},
      h("td", {}, r.agent === "worker" ? "Worker" : "Reviewer"),
      h("td", {}, badge(r.status)),
      h("td", { class: "mono" }, r.a2a_state ?? "—"),
      h("td", { class: "mono" }, r.a2a_task_id ?? "—"),
      h("td", {}, duration(r.started_at, r.finished_at)),
      h("td", {}, r.error ?? ""),
    );
  }

  function render(w: WorkflowDetail) {
    const active = w.status === "queued" || w.status === "running";
    const sections: Node[] = [
      h(
        "section",
        { class: "card" },
        h("div", { class: "header-row" }, h("h1", {}, "Workflow"), badge(w.status), w.verdict ? badge(w.verdict) : null,
          active ? h("span", { class: "hint" }, h("span", { class: "spinner" }), " updating…") : null),
        h("p", { class: "question-text" }, w.question),
        w.error ? message("error", w.error) : null,
        h("h3", {}, "Timeline"),
        h(
          "dl",
          { class: "meta" },
          h("dt", {}, "ID"), h("dd", { class: "mono" }, w.id),
          h("dt", {}, "Submitted"), h("dd", {}, formatTime(w.created_at)),
          h("dt", {}, "Started"), h("dd", {}, formatTime(w.started_at)),
          h("dt", {}, "Finished"), h("dd", {}, formatTime(w.finished_at)),
          h("dt", {}, "Duration"), h("dd", {}, duration(w.started_at, w.finished_at)),
        ),
      ),
      h(
        "section",
        { class: "card" },
        h("h2", {}, "A2A agent runs"),
        w.runs.length === 0
          ? message("empty", active ? "Waiting for the first agent…" : "No agent ran.")
          : h("div", { class: "table-wrap" }, h("table", {},
              h("thead", {}, h("tr", {}, ...["Agent", "Status", "A2A state", "A2A task", "Duration", "Error"].map((t) => h("th", { scope: "col" }, t)))),
              h("tbody", {}, ...w.runs.map(runRow)))),
      ),
    ];

    const draft = w.draft;
    sections.push(
      h(
        "section",
        { class: "card" },
        h("h2", {}, "Worker draft"),
        draft
          ? h("div", {},
              h("h3", {}, draft.title),
              h("p", {}, draft.summary),
              h("pre", { class: "content" }, draft.content),
              draft.assumptions.length
                ? h("div", {}, h("h3", {}, "Assumptions"), h("ul", {}, ...draft.assumptions.map((a) => h("li", {}, a))))
                : null)
          : message("empty", active ? "Draft not ready yet." : "No draft was produced."),
      ),
    );

    const review = w.review;
    sections.push(
      h(
        "section",
        { class: "card" },
        h("h2", {}, "Reviewer verdict"),
        review
          ? h("div", {},
              h("div", { class: "header-row" }, badge(review.verdict)),
              h("p", {}, review.summary),
              review.findings.length
                ? h("ul", { class: "findings" }, ...review.findings.map((f) =>
                    h("li", {}, badge(f.severity), h("span", { class: "finding-title" }, f.title), h("p", {}, f.detail))))
                : message("empty", "No findings."))
          : message("empty", active ? "Review not ready yet." : "No review was produced."),
      ),
    );
    root.replaceChildren(...sections);
    return active;
  }

  async function poll() {
    try {
      const w = await api.get(id);
      document.title = `Workflow (${w.status}) · A2A Review`;
      if (render(w)) setTimeout(() => void poll(), 1500);
    } catch (e) {
      const text = e instanceof ApiError && e.status === 404 ? "Workflow not found." : e instanceof ApiError ? e.message : "Could not load workflow.";
      root.replaceChildren(message("error", text));
      if (!(e instanceof ApiError && e.status === 404)) setTimeout(() => void poll(), 3000);
    }
  }

  if (!UUID.test(id)) {
    root.replaceChildren(message("error", "Missing or invalid workflow id."), h("p", {}, h("a", { href: "/history/" }, "Back to history")));
  } else {
    void poll();
  }
</script>
