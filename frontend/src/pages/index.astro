---
// Dashboard: submit a task, see whether one is running, see recent results.
// POST is a plain form submission forwarded to `POST /api/workflows`; on
// success the browser is redirected (303) to the workflow's detail page.
import DashboardLayout from "../layouts/DashboardLayout.astro";
import PageHeader from "../components/navigation/PageHeader.astro";
import Card from "../components/ui/Card.astro";
import Button from "../components/ui/Button.astro";
import Callout from "../components/ui/Callout.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import ErrorState from "../components/ui/ErrorState.astro";
import TaskForm, { type FormNotice } from "../features/workflows/components/TaskForm.astro";
import WorkflowList from "../features/workflows/components/WorkflowList.astro";
import AgentDirectory from "../features/agents/components/AgentDirectory.astro";
import { api } from "../lib/config.ts";
import { ApiError, describeLoadError, fieldMessage } from "../lib/errors.ts";
import { truncate } from "../lib/format.ts";
import { isActive, type Workflow } from "../features/workflows/schemas.ts";

const KEY = /^[A-Za-z0-9_-]{1,128}$/;
const MAX_FORM_BYTES = 64 * 1024;

let idempotencyKey: string = crypto.randomUUID();
let value = "";
let fieldError: string | undefined;
let notice: FormNotice | undefined;

if (Astro.request.method === "POST") {
  const length = Number(Astro.request.headers.get("content-length") ?? "0");
  const form = length > MAX_FORM_BYTES ? null : await Astro.request.formData().catch(() => null);
  if (!form) {
    Astro.response.status = length > MAX_FORM_BYTES ? 413 : 400;
    fieldError = length > MAX_FORM_BYTES ? "The question is too long." : "The form could not be read. Try again.";
  } else {
    value = String(form.get("question") ?? "");
    const posted = String(form.get("idempotency_key") ?? "");
    if (KEY.test(posted)) idempotencyKey = posted;
    try {
      const { workflow } = await api.create(value.trim(), idempotencyKey);
      return Astro.redirect(`/workflows/${workflow.id}`, 303);
    } catch (e) {
      const err = e instanceof ApiError ? e : null;
      Astro.response.status = err?.kind === "http" ? err.status : 503;
      if (err?.code === "validation_failed") {
        fieldError = fieldMessage(err.message);
      } else if (err?.code === "payload_too_large") {
        fieldError = "The question is too long.";
      } else if (err?.code === "workflow_active") {
        notice = {
          tone: "warning",
          title: "Another workflow is still running",
          detail: "Only one workflow runs at a time. Your question is kept below; submit it again when the current one finishes.",
        };
      } else if (err?.code === "idempotency_key_mismatch") {
        idempotencyKey = crypto.randomUUID();
        notice = {
          tone: "warning",
          title: "Please submit again",
          detail: "This form was already used for a different question. It has been reset; submit once more.",
        };
      } else if (err?.uncertain) {
        // The workflow may exist. Keep the key: resubmitting the same question
        // replays it instead of starting a second one.
        notice = {
          tone: "error",
          title: "We couldn't confirm the submission",
          detail: "The API did not answer in time. Your task may have started. Check Workflows, or submit again: the same question will not run twice.",
          link: { href: "/workflows", label: "Open Workflows" },
        };
      } else {
        notice = {
          tone: "error",
          title: "The task was not submitted",
          detail:
            err?.kind === "network"
              ? "The orchestrator API is unreachable. Check that it is running, then submit again."
              : `The API refused the request (${err?.code ?? "unknown error"}). Submit again, or check the API logs.`,
        };
      }
    }
  }
}

const [recentResult, agentsResult] = await Promise.allSettled([api.list({ limit: 5 }), api.agents()]);
const recent: Workflow[] | null = recentResult.status === "fulfilled" ? recentResult.value.items : null;
const agents = agentsResult.status === "fulfilled" ? agentsResult.value : null;
const active = recent?.find((w) => isActive(w.status));
const recentError = recentResult.status === "rejected" ? describeLoadError(recentResult.reason, "recent workflows") : null;

if (notice?.title === "Another workflow is still running" && active) {
  notice.link = { href: `/workflows/${active.id}`, label: "View the running workflow" };
}
---

<DashboardLayout title="Dashboard" active="dashboard">
  <PageHeader
    title="Dashboard"
    description="Ask a software engineering question. A Worker agent drafts an answer and a Reviewer agent independently checks it, over the Agent2Agent protocol."
  />

  <div class="dashboard">
    <div class="dashboard__primary">
      {
        active && !notice && (
          <Callout tone="info" title="A workflow is in progress" icon="loader">
            <p>{truncate(active.question, 140)}</p>
            <div class="callout__actions">
              <Button href={`/workflows/${active.id}`} size="sm" iconEnd="arrow-right">
                View progress
              </Button>
            </div>
          </Callout>
        )
      }

      <Card title="New task" id="new-task" icon="send">
        <TaskForm idempotencyKey={idempotencyKey} value={value} fieldError={fieldError} notice={notice} />
      </Card>

      <Card title="Recent workflows" id="recent" flush>
        <Fragment slot="actions">
          {recent && recent.length > 0 && <Button href="/workflows" size="sm" variant="ghost" iconEnd="arrow-right">View all</Button>}
        </Fragment>
        {
          recentError ? (
            <div class="pad">
              <ErrorState title={recentError.title} detail={recentError.detail} />
            </div>
          ) : recent && recent.length > 0 ? (
            <WorkflowList items={recent} compact />
          ) : (
            <EmptyState compact title="No workflows yet" description="Your submitted tasks and their reviews will appear here." />
          )
        }
      </Card>
    </div>

    <aside class="dashboard__aside" aria-label="How it works">
      <Card title="How it works" id="how" level={2}>
        <AgentDirectory agents={agents} />
      </Card>
    </aside>
  </div>
</DashboardLayout>

<style>
  .dashboard {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: var(--space-5);
    align-items: start;
  }
  .dashboard__primary {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    min-width: 0;
  }
  .dashboard__aside {
    position: sticky;
    top: var(--space-6);
  }
  .pad {
    padding: var(--space-4);
  }
  @media (max-width: 1100px) {
    .dashboard {
      grid-template-columns: minmax(0, 1fr);
    }
    .dashboard__aside {
      position: static;
    }
  }
</style>
