---
import "../styles/global.css";

interface Props {
  title: string;
  active?: "submit" | "history";
}
const { title, active } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>{title} · A2A Review</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">A2A Review</a>
      <nav aria-label="Main">
        <a href="/" aria-current={active === "submit" ? "page" : undefined}>Submit</a>
        <a href="/history/" aria-current={active === "history" ? "page" : undefined}>History</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      Worker → Reviewer over the Agent2Agent protocol. Agent output is displayed as text and never executed.
    </footer>
  </body>
</html>
